secrets:
  serviceAccountName: svc-storefront-built-robot

  vault.hashicorp.com/service: https://secmgmt-api-pd1.geico.net/api/vault
  vault.hashicorp.com/role: vr_mobility-ops-storefront-np
  vault.hashicorp.com/secret-volume-path: /vault/secrets
  vault.hashicorp.com/tls-secret: vault-tls-secret

  # Inject dynamic secrets as valid JSON
  vault.hashicorp.com/agent-inject-secret-api.json: ve_mobility-ops-storefront-np/data/api
  vault.hashicorp.com/agent-inject-template-api.json: |
    {{- with secret "ve_mobility-ops-storefront-np/data/api" -}}
    {
    {{- $counter := 1 -}}
    {{- $totalKeys := len .Data.data -}}
    {{- range $key, $value := .Data.data }}
      "{{ $key }}": "{{ $value }}"{{ if ne $counter $totalKeys }},{{ end }}
      {{- $counter = add $counter 1 -}}
    {{- end }}
    }
    {{- end }}

     # Inject certs into /vault/certs/ folder
  vault.hashicorp.com/agent-inject-secret-cert1: ve_mobility-ops-storefront-np/server_cert
  vault.hashicorp.com/agent-inject-template-cert1: |
    {{- with secret "ve_mobility-ops-storefront-np/server_cert" -}}
    {{ .Data.data["ca.crt"] }}
    {{- end }}
  vault.hashicorp.com/agent-inject-file-cert1: /vault/certs/ca.crt

  vault.hashicorp.com/agent-inject-secret-cert2: ve_mobility-ops-storefront-np/server_cert
  vault.hashicorp.com/agent-inject-template-cert2: |
    {{- with secret "ve_mobility-ops-storefront-np/server_cert" -}}
    {{ .Data.data["tls.crt"] }}
    {{- end }}
  vault.hashicorp.com/agent-inject-file-cert2: /vault/certs/tls.crt

  vault.hashicorp.com/agent-inject-secret-cert3: ve_mobility-ops-storefront-np/server_cert
  vault.hashicorp.com/agent-inject-template-cert3: |
    {{- with secret "ve_mobility-ops-storefront-np/server_cert" -}}
    {{ .Data.data["tls.key"] }}
    {{- end }}
  vault.hashicorp.com/agent-inject-file-cert3: /vault/certs/tls.key

