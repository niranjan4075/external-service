SELECT 
    r.request_reference,
    r.first_name,
    r.last_name,
    r.device_id,
    d.device_name,
    d.device_model,
    s.notification_sent_time,
    e.event_type,
    e.source_system,
    e.response_status
FROM 
    requests r
LEFT JOIN 
    devices d ON r.device_id = d.device_id
LEFT JOIN 
    slack_response s ON r.request_reference = s.request_reference
LEFT JOIN 
    eventstore e ON r.request_reference = e.request_reference;
